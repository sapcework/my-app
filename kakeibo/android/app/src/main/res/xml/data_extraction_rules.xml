<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 以降のバックアップ設定。家計簿のデータとパスコードの設定は個人情報なので、クラウドにも端末間転送にも載せない（FastNote と同じ） -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
