{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ktlint-format.js\"",
            "timeout": 120,
            "statusMessage": "ktlintで整形中..."
          }
        ]
      }
    ]
  }
}
